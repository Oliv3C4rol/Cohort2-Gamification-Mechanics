# Copy this file to .env  ->  cp .env.example .env
# NEVER commit .env. NEVER use a key that has ever held real funds.

# Avalanche Fuji testnet RPC (default is fine)
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# A TEST-ONLY private key, funded with Fuji AVAX from the Builders Hub faucet
PRIVATE_KEY=

# YOUR LoyaltyPoints address from Session 2 (Quest 2). RECOMMENDED:
# tonight's badges & tiers will attach to YOUR ledger — composition, for real.
# Leave empty and the deploy script will deploy a fresh ledger instead.
# NOTE: use the same PRIVATE_KEY that deployed it, so you remain the issuer.
